# Banco de Dados (Credenciais)
POSTGRES_USER=glicovoz
POSTGRES_PASSWORD=secret_password_here
POSTGRES_DB=glicovoz_db

# Configuração de Banco de Dados PostgreSQL (URL para rodar o app localmente)
DATABASE_URL=postgresql://glicovoz:secret_password_here@localhost:5432/glicovoz_db

# Endereço do servidor Ollama local
OLLAMA_HOST=http://localhost:11434
OLLAMA_HOST_DOCKER=http://host.docker.internal:11434

# Porta do Streamlit
PORT=8501

# Modelos VLM (Ollama)
VLM_PRIMARY_MODEL=minicpm-v
VLM_SECONDARY_MODEL=qwen2.5-vl:7b
